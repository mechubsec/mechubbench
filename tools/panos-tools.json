[
  {
    "name": "create_panos_change_set",
    "description": "Plan and persist 1-64 ordered PAN-OS candidate actions under inventory and token XPath/action scopes",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "ChangeSetAction": {
          "description": "One action in an exact, digest-bound change set.",
          "type": "object",
          "properties": {
            "action": {
              "description": "Set or delete.",
              "$ref": "#/$defs/StageAction"
            },
            "xpath": {
              "description": "Exact XPath within both inventory and token policy.",
              "type": "string"
            },
            "element": {
              "description": "One XML element; required for set and forbidden for delete.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "destructive_confirmation": {
              "description": "For delete, must equal `DELETE <xpath>` exactly.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "xpath"
          ]
        },
        "StageAction": {
          "description": "Candidate configuration action supported by the guarded stage tool.",
          "oneOf": [
            {
              "description": "Merge the supplied XML element at the XPath.",
              "type": "string",
              "const": "set"
            },
            {
              "description": "Delete the exact XPath after policy and confirmation checks.",
              "type": "string",
              "const": "delete"
            }
          ]
        }
      },
      "required": [
        "device",
        "expected_candidate_fingerprint",
        "actions"
      ],
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device.",
          "type": "string"
        },
        "expected_candidate_fingerprint": {
          "description": "Candidate fingerprint to which this plan is bound.",
          "type": "string"
        },
        "actions": {
          "description": "Ordered actions; all are covered by one digest and approval.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeSetAction"
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "diff_panos_candidate",
    "description": "Return a bounded PAN-OS change summary for the exact staged candidate fingerprint",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device",
        "operation_id",
        "expected_candidate_fingerprint"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device.",
          "type": "string"
        },
        "operation_id": {
          "description": "Operation identifier returned by stage.",
          "type": "string"
        },
        "expected_candidate_fingerprint": {
          "description": "Candidate fingerprint expected at this lifecycle step.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "discard_panos_candidate",
    "description": "Discard a staged operation through an admin-scoped partial candidate revert",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device",
        "operation_id",
        "expected_candidate_fingerprint"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device.",
          "type": "string"
        },
        "operation_id": {
          "description": "Operation identifier returned by stage.",
          "type": "string"
        },
        "expected_candidate_fingerprint": {
          "description": "Candidate fingerprint expected at this lifecycle step.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "execute_panos_op",
    "description": "Execute a read-only PAN-OS XML command rooted at <show> on an authorized device, with output caps",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device",
        "command"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device name.",
          "type": "string"
        },
        "command": {
          "description": "A single XML operational command rooted at `<show>`.",
          "type": "string"
        },
        "max_bytes": {
          "description": "Optional returned-content cap; defaults to 524288 and cannot exceed 5242880.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "max_lines": {
          "description": "Optional returned-line cap; defaults to 10000 and cannot exceed 100000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        }
      }
    }
  },
  {
    "name": "gather_device_facts",
    "description": "Gather hostname, model, serial, version, management IP, and uptime from an authorized PAN-OS device",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device name.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "get_candidate_fingerprint",
    "description": "Return a SHA-256 fingerprint over all operator-authorized candidate subtrees",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "get_panos_change_set",
    "description": "Return the exact actions, digest, approval, expiry, and operation state for review or recovery",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device",
        "change_set_id"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device.",
          "type": "string"
        },
        "change_set_id": {
          "description": "Change-set identifier.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "get_panos_config",
    "description": "Read running or candidate PAN-OS configuration at a validated /config XPath on an authorized device",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "ConfigSource": {
          "description": "PAN-OS configuration data source.",
          "oneOf": [
            {
              "description": "Active/running configuration via XML API action `show`.",
              "type": "string",
              "const": "running"
            },
            {
              "description": "Candidate configuration via XML API action `get`.",
              "type": "string",
              "const": "candidate"
            }
          ]
        }
      },
      "required": [
        "device"
      ],
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device name.",
          "type": "string"
        },
        "source": {
          "description": "Running or candidate configuration; defaults to running.",
          "$ref": "#/$defs/ConfigSource",
          "default": "running"
        },
        "xpath": {
          "description": "Optional XPath rooted at `/config`; defaults to `/config`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "max_bytes": {
          "description": "Optional returned-content cap; defaults to 524288 and cannot exceed 5242880.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "max_lines": {
          "description": "Optional returned-line cap; defaults to 10000 and cannot exceed 100000.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_panos_operation",
    "description": "Return safe status for an owned PAN-OS candidate lifecycle operation",
    "inputSchema": {
