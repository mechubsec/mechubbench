          "description": "Exact inventory device.",
          "type": "string"
        },
        "operation_id": {
          "description": "Operation identifier returned by stage.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_devices",
    "description": "List authorized PAN-OS devices and safe metadata; never returns API keys",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object"
    }
  },
  {
    "name": "validate_panos_candidate",
    "description": "Validate a staged candidate and make only the same fingerprint eligible for commit",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "device",
        "operation_id",
        "expected_candidate_fingerprint"
      ],
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "device": {
          "description": "Exact inventory device.",
          "type": "string"
        },
        "operation_id": {
          "description": "Operation identifier returned by stage.",
          "type": "string"
        },
        "expected_candidate_fingerprint": {
          "description": "Candidate fingerprint expected at this lifecycle step.",
          "type": "string"
        }
      }
    }
  }
